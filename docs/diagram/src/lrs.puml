pengguna ||--o{ tagihan
tagihan ||--o{ detail_tagihan
jenis_biaya ||--o{ detail_tagihan
siswa ||--o{ pembayaran
pengguna ||--o{ pembayaran
pembayaran ||--o{ alokasi_pembayaran
tagihan ||--o{ alokasi_pembayaran
pengguna ||--o{ pengeluaran
