' Dibuat otomatis oleh scripts/generate-docs.ts — jangan diedit manual.
@startuml erd-lengkap
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam roundCorner 8
skinparam linetype ortho
skinparam ArrowColor #7a3f86
skinparam class {
  BackgroundColor #FDF8FD
  BorderColor #A64CA6
  HeaderBackgroundColor #F3E3F3
  FontColor #1f1a2e
}
hide circle
title ERD Sistem Informasi TK Orchid (lengkap, notasi crow's foot)

left to right direction
entity "pengguna" as pengguna {
  * id_pengguna : INTEGER <<PK>>
  --
  * nama : TEXT
  * email : TEXT <<UK>>
    nama_pengguna : TEXT <<UK>>
  * kata_sandi_hash : TEXT
  * peran : TEXT
  * aktif : BOOLEAN
    terakhir_masuk : DATETIME
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "wali" as wali {
  * id_wali : INTEGER <<PK>>
  --
    id_pengguna : INTEGER <<FK,UK>>
  * nama_lengkap : TEXT
  * hubungan : TEXT
    nik : TEXT
    pekerjaan : TEXT
    nama_perusahaan : TEXT
    pendidikan : TEXT
  * telepon : TEXT
    email : TEXT
    alamat : TEXT
    catatan : TEXT
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "guru" as guru {
  * id_guru : INTEGER <<PK>>
  --
  * id_pengguna : INTEGER <<FK,UK>>
    kode_pegawai : TEXT <<UK>>
  * nama_lengkap : TEXT
    telepon : TEXT
    email : TEXT
    pendidikan : TEXT
    spesialisasi : TEXT
    tanggal_bergabung : DATETIME
  * aktif : BOOLEAN
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "tahun_ajaran" as tahun_ajaran {
  * id_tahun_ajaran : INTEGER <<PK>>
  --
  * nama : TEXT <<UK>>
  * tanggal_mulai : DATETIME
  * tanggal_selesai : DATETIME
  * status : TEXT
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "siswa" as siswa {
  * id_siswa : INTEGER <<PK>>
  --
  * kode_siswa : TEXT <<UK>>
    nis : TEXT <<UK>>
    nisn : TEXT <<UK>>
    nik : TEXT
  * nama_lengkap : TEXT
    nama_panggilan : TEXT
  * jenis_kelamin : TEXT
    tempat_lahir : TEXT
  * tanggal_lahir : DATETIME
    agama : TEXT
    alamat : TEXT
    rt : TEXT
    rw : TEXT
    kelurahan : TEXT
    kecamatan : TEXT
    kota : TEXT
    provinsi : TEXT
    kode_pos : TEXT
    anak_ke : INTEGER
    jumlah_saudara : INTEGER
    status_tempat_tinggal : TEXT
    tanggal_masuk : DATETIME
    tanggal_keluar : DATETIME
    alasan_keluar : TEXT
  * status : TEXT
    lokasi_foto : TEXT
    catatan : TEXT
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "siswa_wali" as siswa_wali {
  * id_siswa : INTEGER <<PK,FK>>
  * id_wali : INTEGER <<PK,FK>>
  --
  * wali_utama : BOOLEAN
  * boleh_menjemput : BOOLEAN
  * dibuat_pada : DATETIME
}

entity "kelas" as kelas {
  * id_kelas : INTEGER <<PK>>
  --
  * id_tahun_ajaran : INTEGER <<FK>>
  * kode : TEXT
  * nama : TEXT
  * jenjang : TEXT
    ruang : TEXT
    id_guru : INTEGER <<FK>>
  * kapasitas : INTEGER
  * status : TEXT
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "penempatan_kelas" as penempatan_kelas {
  * id_penempatan : INTEGER <<PK>>
  --
  * id_siswa : INTEGER <<FK>>
  * id_tahun_ajaran : INTEGER <<FK>>
  * id_kelas : INTEGER <<FK>>
  * tanggal_penempatan : DATETIME
  * status : TEXT
    catatan : TEXT
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "periode_ppdb" as periode_ppdb {
  * id_periode_ppdb : INTEGER <<PK>>
  --
  * nama : TEXT
  * tanggal_mulai : DATETIME
  * tanggal_selesai : DATETIME
