  * hubungan_wali : TEXT
  * telepon_wali : TEXT
    email_wali : TEXT
    alamat_wali : TEXT
    jenjang_pilihan : TEXT
    sekolah_asal : TEXT
    catatan : TEXT
  * status : TEXT
    alasan_penolakan : TEXT
    ditinjau_oleh : INTEGER <<FK>>
    ditinjau_pada : DATETIME
    dikirim_pada : DATETIME
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "dokumen_pendaftaran" as dokumen_pendaftaran {
  * id_dokumen_pendaftaran : INTEGER <<PK>>
  --
  * id_pendaftaran : INTEGER <<FK>>
  * jenis_dokumen : TEXT
  * nama_file_asli : TEXT
  * lokasi_file : TEXT
  * tipe_mime : TEXT
  * ukuran_byte : INTEGER
  * dibuat_pada : DATETIME
}

entity "domain_penilaian" as domain_penilaian {
  * id_domain : INTEGER <<PK>>
  --
  * nama : TEXT <<UK>>
    deskripsi : TEXT
  * urutan : INTEGER
  * aktif : BOOLEAN
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

entity "skala_penilaian" as skala_penilaian {
  * id_skala : INTEGER <<PK>>
  --
  * kode : TEXT <<UK>>
  * label : TEXT
    deskripsi : TEXT
  * urutan : INTEGER
  * aktif : BOOLEAN
  * dibuat_pada : DATETIME
}

entity "penilaian" as penilaian {
  * id_penilaian : INTEGER <<PK>>
  --
  * id_siswa : INTEGER <<FK>>
  * id_tahun_ajaran : INTEGER <<FK>>
  * id_kelas : INTEGER <<FK>>
  * id_domain : INTEGER <<FK>>
  * id_skala : INTEGER <<FK>>
  * periode : TEXT
