}

entity "presensi" as presensi {
  * id_presensi : INTEGER <<PK>>
  --
  * id_siswa : INTEGER <<FK>>
  * id_kelas : INTEGER <<FK>>
  * tanggal : DATETIME
  * status : TEXT
    catatan : TEXT
  * dicatat_oleh : INTEGER <<FK>>
  * dibuat_pada : DATETIME
  * diperbarui_pada : DATETIME
}

