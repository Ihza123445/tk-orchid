  * diperbarui_pada : DATETIME
}

entity "detail_laporan" as detail_laporan {
  * id_detail_laporan : INTEGER <<PK>>
  --
  * id_laporan : INTEGER <<FK>>
  * id_domain : INTEGER <<FK>>
  * id_skala : INTEGER <<FK>>
